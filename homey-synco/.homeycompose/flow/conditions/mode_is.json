{
  "id": "mode_is",
  "title": {
    "en": "Operating mode is",
    "de": "Betriebsmodus ist"
  },
  "titleFormatted": {
    "en": "[[device]] operating mode is [[mode]]",
    "de": "[[device]] Betriebsmodus ist [[mode]]"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "capabilities=thermostat_mode"
    },
    {
      "type": "dropdown",
      "name": "mode",
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Automatic",
            "de": "Automatik"
          }
        },
        {
          "id": "comfort",
          "label": {
            "en": "Comfort",
            "de": "Komfort"
          }
        },
        {
          "id": "precomfort",
          "label": {
            "en": "Pre-Comfort",
            "de": "Vorkomfort"
          }
        },
        {
          "id": "economy",
          "label": {
            "en": "Economy",
            "de": "Eco"
          }
        },
        {
          "id": "protection",
          "label": {
            "en": "Protection",
            "de": "Schutz"
          }
        }
      ]
    }
  ]
}
