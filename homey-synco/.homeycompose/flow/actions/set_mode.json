{
  "id": "set_mode",
  "title": {
    "en": "Set operating mode",
    "de": "Betriebsmodus setzen"
  },
  "titleFormatted": {
    "en": "Set operating mode to [[mode]]",
    "de": "Setze Betriebsmodus auf [[mode]]"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=room"
    },
    {
      "type": "dropdown",
      "name": "mode",
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Automatic",
            "de": "Automatik"
          }
        },
        {
          "id": "comfort",
          "label": {
            "en": "Comfort",
            "de": "Komfort"
          }
        },
        {
          "id": "precomfort",
          "label": {
            "en": "Pre-Comfort",
            "de": "Vorkomfort"
          }
        },
        {
          "id": "economy",
          "label": {
            "en": "Economy",
            "de": "Eco"
          }
        },
        {
          "id": "protection",
          "label": {
            "en": "Protection",
            "de": "Schutz"
          }
        }
      ]
    }
  ]
}
