{
  "id": "set_temperature",
  "title": {
    "en": "Set temperature",
    "de": "Temperatur setzen"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=room"
    },
    {
      "type": "number",
      "name": "temperature",
      "min": 5,
      "max": 30,
      "step": 0.5,
      "placeholder": {
        "en": "Temperature",
        "de": "Temperatur"
      }
    }
  ]
}
