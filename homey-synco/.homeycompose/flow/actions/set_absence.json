{
  "id": "set_absence",
  "title": {
    "en": "Set absence mode",
    "de": "Abwesenheitsmodus setzen"
  },
  "titleFormatted": {
    "en": "[[device]] [[action]] absence mode",
    "de": "[[device]] Abwesenheitsmodus [[action]]"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "capabilities=thermostat_mode"
    },
    {
      "type": "dropdown",
      "name": "action",
      "values": [
        {
          "id": "enable",
          "label": {
            "en": "Enable",
            "de": "Aktivieren"
          }
        },
        {
          "id": "disable",
          "label": {
            "en": "Disable",
            "de": "Deaktivieren"
          }
        }
      ]
    }
  ]
}
