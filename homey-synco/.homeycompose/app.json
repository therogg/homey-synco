{
  "id": "com.siemens.synco",
  "version": "1.0.2",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Siemens Synco Living",
    "de": "Siemens Synco Living"
  },
  "description": {
    "en": "Smart building automation for your home - control room temperature, ventilation, and comfort",
    "de": "Intelligente Gebäudeautomation für Ihr Zuhause - Raumtemperatur, Lüftung und Komfort steuern"
  },
  "category": ["climate"],
  "permissions": [],
  "settings": [
    {
      "type": "group",
      "title": {
        "en": "Gateway Connection",
        "de": "Gateway-Verbindung"
      },
      "children": [
        {
          "id": "gateway_host",
          "type": "text",
          "title": {
            "en": "Gateway IP Address",
            "de": "Gateway IP-Adresse"
          },
          "hint": {
            "en": "IP address of your OZW772/OZW672 gateway",
            "de": "IP-Adresse Ihres OZW772/OZW672 Gateways"
          },
          "value": ""
        },
        {
          "id": "gateway_username",
          "type": "text",
          "title": {
            "en": "Username",
            "de": "Benutzername"
          },
          "hint": {
            "en": "Username for gateway login",
            "de": "Benutzername für Gateway-Anmeldung"
          },
          "value": ""
        },
        {
          "id": "gateway_password",
          "type": "password",
          "title": {
            "en": "Password",
            "de": "Passwort"
          },
          "hint": {
            "en": "Password for gateway login",
            "de": "Passwort für Gateway-Anmeldung"
          },
          "value": ""
        }
      ]
    }
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Marco Rogg"
  },
  "brandColor": "#009999",
  "tags": {
    "en": ["siemens", "synco", "hvac", "heating", "climate", "room controller", "ozw772", "ozw672"],
    "de": ["siemens", "synco", "heizung", "klima", "raumregler", "ozw772", "ozw672"]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": ""
      }
    }
  },
  "bugs": {
    "url": "https://github.com/therogg/homey-synco/issues"
  },
  "homeyCommunityTopicId": 0,
  "source": "https://github.com/therogg/homey-synco",
  "support": "https://github.com/therogg/homey-synco/issues"
}
