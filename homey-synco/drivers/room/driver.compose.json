{
  "name": {
    "en": "Room",
    "de": "Raum"
  },
  "class": "thermostat",
  "capabilities": [
    "measure_temperature",
    "target_temperature",
    "valve_position",
    "thermostat_mode"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 8,
      "max": 35,
      "step": 0.5
    }
  },
  "energy": {
    "approximation": {
      "usageOn": 0,
      "usageOff": 0
    }
  },
  "pair": [
    {
      "id": "login_credentials"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "login_credentials",
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png"
  }
}
