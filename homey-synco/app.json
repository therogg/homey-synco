    "triggers": [
      {
        "id": "valve_opened",
        "title": {
          "en": "Valve opened above threshold",
          "de": "Ventil über Schwellwert geöffnet"
        },
        "hint": {
          "en": "Triggers when the valve position exceeds the specified threshold",
          "de": "Wird ausgelöst, wenn die Ventilstellung den Schwellwert überschreitet"
        },
