        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=room"
          },
          {
            "type": "number",
            "name": "threshold",
            "min": 0,
            "max": 100,
            "step": 5,
            "placeholder": {
              "en": "Threshold %",
              "de": "Schwellwert %"
