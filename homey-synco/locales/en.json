{
  "app": {
    "name": "Siemens Synco Living",
    "description": "Control Siemens Synco Living room controllers via OZW772/OZW672 gateway"
  },
  "drivers": {
    "room": {
      "name": "Room Controller",
      "pair": {
        "login_credentials": {
          "title": "Connect to OZW Gateway"
        },
        "list_devices": {
          "title": "Select Rooms"
        }
      },
      "settings": {
        "poll_interval": {
          "label": "Polling Interval (seconds)",
          "hint": "How often to poll the gateway for updates"
        },
        "setpoint_type": {
          "label": "Target Temperature Mode",
          "hint": "Which setpoint to control when changing target temperature",
          "values": {
            "comfort": "Comfort",
            "precomfort": "Pre-Comfort",
            "economy": "Economy"
          }
        }
      }
    }
  },
  "pair": {
    "login": {
      "title": "Connect to OZW Gateway",
      "info": "Enter the connection details for your OZW772/OZW672 gateway.",
      "host": "Gateway IP Address",
      "username": "Username",
      "password": "Password",
      "connect": "Connect"
    },
    "list_devices": {
      "title": "Select Rooms"
    }
  },
  "capabilities": {
    "valve_position": {
      "title": "Valve Position"
    },
    "thermostat_mode": {
      "title": "Operating Mode",
      "values": {
        "auto": "Automatic",
        "comfort": "Comfort",
        "precomfort": "Pre-Comfort",
        "economy": "Economy",
        "protection": "Protection"
      }
    }
  },
  "flow": {
    "triggers": {
      "temperature_changed": {
        "title": "Temperature changed",
        "titleFormatted": "The temperature of [[device]] changed",
        "tokens": {
          "temperature": "Temperature"
        }
      },
      "mode_changed": {
        "title": "Operating mode changed",
        "titleFormatted": "The operating mode of [[device]] changed",
        "tokens": {
          "mode": "Mode"
        }
      },
      "valve_opened": {
        "title": "Valve opened above threshold",
        "titleFormatted": "The valve of [[device]] opened above [[threshold]] %",
        "args": {
          "threshold": "Threshold %"
        },
        "tokens": {
          "valve_position": "Valve Position"
        }
      }
    },
    "conditions": {
      "temperature_above": {
        "title": "Temperature is above",
        "titleFormatted": "Temperature of [[device]] is above [[temperature]] °C",
        "args": {
          "temperature": "Temperature"
        }
      },
      "temperature_below": {
        "title": "Temperature is below",
        "titleFormatted": "Temperature of [[device]] is below [[temperature]] °C",
        "args": {
          "temperature": "Temperature"
        }
      },
      "mode_is": {
        "title": "Operating mode is",
        "titleFormatted": "Operating mode of [[device]] is [[mode]]",
        "args": {
          "mode": {
            "auto": "Automatic",
            "comfort": "Comfort",
            "precomfort": "Pre-Comfort",
            "economy": "Economy",
            "protection": "Protection"
          }
        }
      },
      "valve_above": {
        "title": "Valve position is above",
        "titleFormatted": "Valve position of [[device]] is above [[position]] %",
        "args": {
          "position": "Position %"
        }
      }
    },
    "actions": {
      "set_temperature": {
        "title": "Set temperature",
        "titleFormatted": "Set temperature of [[device]] to [[temperature]] °C",
        "args": {
          "temperature": "Temperature"
        }
      },
      "set_mode": {
        "title": "Set operating mode",
        "titleFormatted": "Set operating mode of [[device]] to [[mode]]",
        "args": {
          "mode": {
            "auto": "Automatic",
            "comfort": "Comfort",
            "precomfort": "Pre-Comfort",
            "economy": "Economy",
            "protection": "Protection"
          }
        }
      },
      "set_absence": {
        "title": "Set absence mode",
        "titleFormatted": "[[action]] absence mode for [[device]]",
        "args": {
          "action": {
            "enable": "Enable",
            "disable": "Disable"
          }
        }
      }
    }
  },
  "errors": {
    "connection_failed": "Connection failed. Please check your credentials.",
    "no_rooms_found": "No rooms found on the gateway.",
    "not_connected": "Not connected to gateway.",
    "write_failed": "Failed to write value to gateway."
  }
}
